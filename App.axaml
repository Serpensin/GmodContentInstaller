<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GModContentWizard.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#201D1E</Color>
            <Color x:Key="AccentColor">#00C5FF</Color>
            <Color x:Key="TextColor">White</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>